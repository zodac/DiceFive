*.iml
.gradle/
.kotlin/
/local.properties
/.idea/
.DS_Store
/build
/captures
.externalNativeBuild
.cxx
local.properties
build/
*.hprof
*.jpg
*.jpeg
*.webp
# ...except the app's own bundled art, which ships in the build (each one has its source and
# license in app/licensing/asset-sources.json, which verifyAssetSources checks).
!/app/shared/src/commonMain/composeResources/drawable/*.webp

# Release signing material must never be committed - CI decodes it from secrets at build time.
*.jks
*.keystore
keystore.properties

# ...except the debug key, which IS committed on purpose: it holds no real signing authority (Play
# Store rejects a debug-signed upload outright), and committing it is what lets every debug build -
# Android Studio, CI, a throwaway sandbox container - share one signature so they can always install
# over each other. See the signingConfigs comment in app/android/build.gradle.kts.
!/app/android/debug.keystore

# Claude Code's ~/.claude bind-mounted into the sandbox container - auth tokens, session
# transcripts and memory. See sandbox/README.md's Persistence section.
/sandbox/.claude-history/

# Generated image assets for Play Store
assets/
