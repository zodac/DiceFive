<!--
  Same badge as ic_run_badge_4.xml, showing "5" instead - see that file's header for why this is a
  flattened vector rather than a Compose Text, and CategoryIcon.kt's StairsWithRunBadge for how
  it's used (fixed colors, alpha-only dimming when scored).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Circle background -->
    <path
        android:pathData="M12,1 A11,11 0 1,0 12,23 A11,11 0 1,0 12,1 Z"
        android:fillColor="#0F211D" />

    <!-- Circle ring -->
    <path
        android:pathData="M12,1 A11,11 0 1,0 12,23 A11,11 0 1,0 12,1 Z"
        android:fillColor="#00000000"
        android:strokeColor="#E7F3EF"
        android:strokeAlpha="0.6"
        android:strokeWidth="1" />

    <!-- "5": top, top-left vertical, middle, bottom-right vertical, bottom -->
    <path
        android:pathData="
            M8,5 L16,5 L16,7 L8,7 Z
            M8,7 L10,7 L10,11 L8,11 Z
            M8,11 L16,11 L16,13 L8,13 Z
            M14,13 L16,13 L16,17 L14,17 Z
            M8,17 L16,17 L16,19 L8,19 Z"
        android:fillColor="#E7F3EF" />
</vector>
