<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup up to Android 11 (fullBackupContent): everything but Play Games' start-at-launch choice
     (PlayGamesServices' play_games preferences), which is this device's own - restored onto a new device, it would
     sign the player in there at launch before they'd asked. data_extraction_rules.xml is the same from Android 12. -->
<full-backup-content>
    <exclude domain="sharedpref" path="play_games.xml" />
</full-backup-content>
