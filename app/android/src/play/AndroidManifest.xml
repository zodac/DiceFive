<?xml version="1.0" encoding="utf-8"?>
<!-- The play flavour's own entries: Google Play Games, Sidekick and Play Billing, which the github flavour has none of. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The Billing Library's telemetry (com.google.android.datatransport) asks for the network. The app never uses it:
         purchases go to the Play Store app over IPC, so only that telemetry goes unsent (PlayBillingStoreTest). -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <!-- Backups and device transfers leave out Play Games' start-at-launch choice, which is this device's own, and up to
         Android 11, where adb can edit and restore a backup, everything but the settings: see res/xml/backup_rules.xml
         (up to Android 11) and data_extraction_rules.xml (from 12). -->
    <application
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        tools:targetApi="31">

        <meta-data
            android:name="com.google.android.gms.games.APP_ID"
            android:value="@string/game_services_project_id" />

        <!-- Play Games Sidekick's tab position and snooze; read by Play only for a bundle installed from Play. -->
        <meta-data
            android:name="com.google.android.finsky.deku.OVERLAY_CONFIG"
            android:resource="@xml/sidekick_config" />

        <!-- The Play Games SDK starts itself (and so signs in) at every launch through this provider. It's started by
             PlayGamesServices instead, only once the player has signed in from Settings. Disabled rather than removed:
             a removal warns in every merge without the SDK's manifest (the unit tests'), and this way the tests see it. -->
        <provider
            android:name="com.google.android.gms.games.provider.PlayGamesInitProvider"
            android:authorities="${applicationId}.playgamesinitprovider"
            android:enabled="false"
            android:exported="false" />
    </application>

</manifest>
