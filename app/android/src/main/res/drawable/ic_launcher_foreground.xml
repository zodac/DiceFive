                    android:type="radial"
                    android:centerX="54"
                    android:centerY="91"
                    android:gradientRadius="23.6">
                    <item android:offset="0" android:color="#99000000" />
                    <item android:offset="0.6" android:color="#66000000" />
                    <item android:offset="1" android:color="#00000000" />
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <!-- Dice cup: a silhouette of the in-game "Classic" shaker (CasinoDiceCupStyle in
         RoundCups.kt) - straight sides, seen from the same raised angle, so its mouth and base are
         ellipses squashed to 0.38 of their width (CUP_VIEW_SQUASH), with its single band round the
         body. Radius 13.4 about x=54, rim at y=44.1, base at y=88.9: the real cup (radius 20, 67 grid
         units from rim to base) scaled evenly by 0.67. Front arcs are cubics with controls 4/3 of the
         ellipse's half-height (5.09) down, as the game's own frontArc() draws them. Its colours are
         shaded round the Classic cup's Gold (casino_gold in StyleCatalog.kt), the default, so a new
         player's first cup is this one - change them together. -->
    <path android:pathData="M40.6,44.1 L40.6,88.9 C40.6,95.69 67.4,95.69 67.4,88.9 L67.4,44.1 Z">
