<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      Kept close to the 66dp "safe zone" circle centred on (54,54) - the region every
      adaptive-icon mask (circle, squircle, rounded square, teardrop) is guaranteed not to crop.
      Three dice sit above the cup's mouth (the top of its rim ellipse is at y~39), never dipping
      into it; two more flank the cup lower down, below the opening, offset from each other by one
      die height (14 units) so they don't read as a mirrored pair.

      Pip positions and radius are derived from the real dice: BeveledDie.kt pads its die box by
      6dp on each side before laying out pips, and PipFace draws them at pipRadiusFraction=0.11
      inside that padded box (Pips.kt's PIP_LAYOUTS fractions, e.g. 0.26/0.5/0.74). Taking
      AppLogo.kt's 34dp fan dice as the reference size, that works out to each pip corner sitting
      at ~34.5%/65.5% of the die's own height (not 30%/70%) and each pip's radius at ~7.1% of that
      height - scaled here to this icon's smaller 14/15-unit dice.

      One light falls from the top left, whichever way a die has spun, and from the same side as the
      felt's glow in ic_launcher_background.xml.
    -->

    <!-- Everything below scaled down around the icon's centre (54,54) - a pure zoom, so every
         internal ratio (pip fractions, die corner rounding, relative sizes) stays identical;
         only the overall footprint shrinks. The real launcher mask crops noticeably tighter than
         the nominal 66dp "safe zone" circle this file's math had been checked against (confirmed
         against device screenshots showing dice flat-cut at this scale's edges) - see UI.md's
         "adaptive-icon safe zone" gotcha. All the individual dice/cup coordinates below were also
         shifted down 3 units on top of this scale, to pull the topmost die (the 5) clear of the
         top edge. -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.8"
        android:scaleY="0.8">

    <!-- The cup's contact shadow: a circle's soft falloff, squashed flat. -->
    <group
        android:pivotX="54"
        android:pivotY="91"
        android:scaleY="0.3">
        <path android:pathData="M24,91 a30,30 0 1,0 60,0 a30,30 0 1,0 -60,0 z">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="radial"
                    android:centerX="54"
                    android:centerY="91"
                    android:gradientRadius="30">
                    <item android:offset="0" android:color="#99000000" />
                    <item android:offset="0.6" android:color="#66000000" />
                    <item android:offset="1" android:color="#00000000" />
                </gradient>
            </aapt:attr>
        </path>
    </group>

    <!-- Dice cup: a silhouette of the in-game "Classic" shaker (CasinoDiceCupStyle in
         RoundCups.kt) - straight sides, seen from the same raised angle, so its mouth and base are
         ellipses squashed to 0.38 of their width (CUP_VIEW_SQUASH), with its single band round the
         body. Radius 17 about x=54, rim at y=45.5, base at y=87.5: a little stubbier than the real
         cup (40 x 67 grid units) so it fits under the dice. Front arcs are cubics with controls 4/3
         of the ellipse's half-height (6.46) down, as the game's own frontArc() draws them. Its
         colours are shaded round the Classic cup's Gold (casino_gold in StyleCatalog.kt), the
         default, so a new player's first cup is this one - change them together. -->
    <path android:pathData="M37,45.5 L37,87.5 C37,96.11 71,96.11 71,87.5 L71,45.5 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="37"
                android:startY="60"
                android:endX="71"
                android:endY="60">
                <item android:offset="0" android:color="#8F6A2C" />
                <item android:offset="0.2" android:color="#C79A4B" />
                <item android:offset="0.38" android:color="#F2D694" />
                <item android:offset="0.6" android:color="#C79A4B" />
                <item android:offset="1" android:color="#7A5620" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- The band - the game draws it 79% of the way down the cup. A filled crescent ending on the
         cup's sides (the same shape as the hole in ic_launcher_monochrome.xml), not a stroke, whose
         ends would stick out past them. -->
    <path
        android:pathData="M37,77.6 C37,86.21 71,86.21 71,77.6 L71,79.4 C71,88.01 37,88.01 37,79.4 z"
        android:fillColor="#0B1E3A" />

    <!-- The open mouth: dark depths inside a lighter gold rim. -->
    <path
        android:pathData="M37,45.5 a17,6.46 0 1,0 34,0 a17,6.46 0 1,0 -34,0 z"
        android:strokeWidth="1.8">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="50"
                android:gradientRadius="19">
                <item android:offset="0" android:color="#4A3620" />
                <item android:offset="1" android:color="#17100A" />
            </gradient>
        </aapt:attr>
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="37"
                android:startY="45"
                android:endX="71"
                android:endY="45">
                <item android:offset="0" android:color="#C79A4B" />
                <item android:offset="0.35" android:color="#FFEDBB" />
                <item android:offset="1" android:color="#B98C3E" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Every die is the game's default Ivory die (IvoryDiceStyle, BeveledDie.kt): a diagonal
         gradient a little stronger than IvoryDiceTop-to-IvoryDiceBottom, a faint border in the bottom
         colour at 60% alpha, and DicePipColor pips. Each die's gradient and its shadow (the first
         group inside it) are worked back through its rotation, so they all point down and right on
         screen.

