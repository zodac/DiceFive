            android:strokeColor="#99D9C9A3"
            android:strokeWidth="0.4">
            <aapt:attr name="android:fillColor">
                <gradient
                    android:type="linear"
                    android:startX="8.06"
                    android:startY="-1.62"
                    android:endX="5.94"
                    android:endY="15.62"
