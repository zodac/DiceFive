        android:translateX="49"
        android:translateY="13.5"
        android:pivotX="7"
        android:pivotY="7"
        android:rotation="-5">
        <path
            android:pathData="M3.5,0 h7 a3.5,3.5 0 0 1 3.5,3.5 v7 a3.5,3.5 0 0 1 -3.5,3.5 h-7 a3.5,3.5 0 0 1 -3.5,-3.5 v-7 a3.5,3.5 0 0 1 3.5,-3.5 z"
            android:fillColor="#1E4B86"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="0.5" />
        <path
            android:pathData="M4.83,4.83 m-1.00,0 a1.00,1.00 0 1,0 2.00,0 a1.00,1.00 0 1,0 -2.00,0"
            android:fillColor="#FFFFFF" />
        <path
            android:pathData="M9.18,4.83 m-1.00,0 a1.00,1.00 0 1,0 2.00,0 a1.00,1.00 0 1,0 -2.00,0"
            android:fillColor="#FFFFFF" />
        <path
            android:pathData="M7,7 m-1.00,0 a1.00,1.00 0 1,0 2.00,0 a1.00,1.00 0 1,0 -2.00,0"
            android:fillColor="#FFFFFF" />
        <path
            android:pathData="M4.83,9.18 m-1.00,0 a1.00,1.00 0 1,0 2.00,0 a1.00,1.00 0 1,0 -2.00,0"
            android:fillColor="#FFFFFF" />
        <path
            android:pathData="M9.18,9.18 m-1.00,0 a1.00,1.00 0 1,0 2.00,0 a1.00,1.00 0 1,0 -2.00,0"
            android:fillColor="#FFFFFF" />
    </group>

    <!-- Gold die, showing 3, tumbling out above the rim - fourth in the menu logo's order. -->
    <group
        android:translateX="70.6"
        android:translateY="22.9"
        android:pivotX="7"
        android:pivotY="7"
        android:rotation="18">
        <path
            android:pathData="M3.5,0 h7 a3.5,3.5 0 0 1 3.5,3.5 v7 a3.5,3.5 0 0 1 -3.5,3.5 h-7 a3.5,3.5 0 0 1 -3.5,-3.5 v-7 a3.5,3.5 0 0 1 3.5,-3.5 z"
            android:fillColor="#FFCC55" />
        <path
            android:pathData="M4.83,4.83 m-1.00,0 a1.00,1.00 0 1,0 2.00,0 a1.00,1.00 0 1,0 -2.00,0"
            android:fillColor="#2B2118" />
        <path
            android:pathData="M7,7 m-1.00,0 a1.00,1.00 0 1,0 2.00,0 a1.00,1.00 0 1,0 -2.00,0"
            android:fillColor="#2B2118" />
        <path
            android:pathData="M9.18,9.18 m-1.00,0 a1.00,1.00 0 1,0 2.00,0 a1.00,1.00 0 1,0 -2.00,0"
            android:fillColor="#2B2118" />
    </group>

    <!-- White die, showing 6, below the cup's opening - last in the menu logo's order. -->
    <group
        android:translateX="84.25"
        android:translateY="47.2"
        android:pivotX="7"
        android:pivotY="7"
        android:rotation="-77">
        <path
            android:pathData="M3.5,0 h7 a3.5,3.5 0 0 1 3.5,3.5 v7 a3.5,3.5 0 0 1 -3.5,3.5 h-7 a3.5,3.5 0 0 1 -3.5,-3.5 v-7 a3.5,3.5 0 0 1 3.5,-3.5 z"
            android:fillColor="#FFFCF3" />
        <path
            android:pathData="M4.83,4.46 m-1.00,0 a1.00,1.00 0 1,0 2.00,0 a1.00,1.00 0 1,0 -2.00,0"
            android:fillColor="#2B2118" />
        <path
            android:pathData="M4.83,7 m-1.00,0 a1.00,1.00 0 1,0 2.00,0 a1.00,1.00 0 1,0 -2.00,0"
            android:fillColor="#2B2118" />
        <path
            android:pathData="M4.83,9.54 m-1.00,0 a1.00,1.00 0 1,0 2.00,0 a1.00,1.00 0 1,0 -2.00,0"
            android:fillColor="#2B2118" />
        <path
            android:pathData="M9.18,4.46 m-1.00,0 a1.00,1.00 0 1,0 2.00,0 a1.00,1.00 0 1,0 -2.00,0"
