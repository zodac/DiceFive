            android:fillColor="#2B2118" />
    </group>

    <!-- Blue die, showing 5, centred between the other two, above the rim - matches the menu
         logo's own centre die. Brand blue (the secondary seed, #1E4B86) with a white outline so
         it reads clearly against the navy background instead of blending into it. -->
