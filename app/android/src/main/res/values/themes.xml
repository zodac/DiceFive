<resources>
    <!-- The window is the backdrop's colour, so the system's launch screen hands over to the app's first frame
         without a change of colour. From Android 12 the launch screen takes its background from it too.
         The bars are transparent here rather than through Window's deprecated setters, for the versions below Android 15
         (later ones ignore these): the backdrop runs under them, and this dark parent keeps their icons light. -->
    <style name="Base.Theme.DiceFive" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.DiceFive" parent="Base.Theme.DiceFive" />
</resources>
