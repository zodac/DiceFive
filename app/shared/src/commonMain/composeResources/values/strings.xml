<?xml version="1.0" encoding="utf-8"?>
<!--
    Every player-visible and spoken string in the shared UI, in British English (the base locale).
    Conventions - key names, positional arguments, plurals, what stays out of here - are in
    .claude/I18N.md. A translation goes in values-xx/strings.xml beside this file.
-->
<resources>

    <!--
        The language of this file, as a BCP 47 tag. Not shown: it's what numbers inside the text are
        formatted in (ordinals, so far), so they always match the words around them - a French phone
        on an untranslated app gets English text and "1st", not English text and "1er". Every
        translation sets its own ("fr", "de"...). See .claude/I18N.md.
    -->
    <string name="common_locale">en-GB</string>

    <!--
        How two spoken clauses join, for a sentence whose pieces come and go ("Scored 12, would score
        15"); several are joined one pair at a time. Keep both arguments.
    -->
    <string name="common_clauses_join">%1$s, %2$s</string>
    <!-- How two spoken sentences join into running text. Keep both arguments. -->
    <string name="common_sentences_join">%1$s %2$s</string>

    <!-- Leave game confirmation (ui/game/LeaveGameConfirmation.kt) -->
    <string name="game_leave_title">Leave game?</string>
    <string name="game_leave_message">Your progress is saved - you can continue this game later.</string>
    <string name="game_leave_confirm">Leave</string>
    <string name="game_leave_dismiss">Cancel</string>

    <!-- Dice cup (ui/game/DiceCupPanel.kt) -->
    <!-- What TalkBack says for the cup, in place of the "x3" drawn beside it. -->
    <plurals name="game_cup_cd">
        <item quantity="one">Dice cup, %1$d roll left</item>
        <item quantity="other">Dice cup, %1$d rolls left</item>
    </plurals>
    <!-- TalkBack's name for tapping the cup: "Double-tap to roll". -->
    <string name="game_cup_roll_action">Roll</string>

    <!-- What TalkBack says for the turn timer while it counts down (ui/game/GameScreen.kt, TurnTimerBadge). -->
    <plurals name="game_timer_left_cd">
        <item quantity="one">Time left: %1$d second</item>
        <item quantity="other">Time left: %1$d seconds</item>
    </plurals>

    <!--
        What TalkBack says for a Hit List target tile, after its name (ui/game/ScoreGrid.kt, targetProgress): how close the
        dice are. %1$d numbers rolled / in place, out of %2$d the target calls.
    -->
    <string name="game_target_exact_hit_spoken">exact hit</string>
    <!-- %1$d is how many of the %2$d numbers are in their places. -->
    <string name="game_target_hit_spoken">hit, %1$d of %2$d in place</string>
    <!-- %1$d of the %2$d numbers are rolled, %3$d of them in their places. -->
    <string name="game_target_partial_hit_spoken">partial hit, %1$d of %2$d rolled, %3$d in place</string>
    <string name="game_target_progress_spoken">%1$d of %2$d rolled, %3$d in place</string>

    <!--
        What TalkBack says for a box with several slots (Third Wind; ui/game/ScoreGrid.kt, stackedSpokenState). The
        clauses that apply are joined with common_clauses_join, in this order, and the first letter is capitalised.
    -->
    <!-- %1$s is the scores so far, joined into a list: "Scored 12, 9". -->
    <string name="game_slots_scored_spoken">Scored %1$s</string>
    <string name="game_slots_would_score_spoken">would score %1$d</string>
    <!-- Slots still open after the one the dice would fill. -->
    <string name="game_slots_more_open_spoken">%1$d more open</string>
    <string name="game_slots_open_spoken">%1$d open</string>
    <string name="game_slots_bonus_spoken">plus %1$d bonus</string>
    <string name="game_slots_last_score_spoken">last turn's score %1$d</string>

    <!-- A player's place, on their tab (ui/game/PlayerHeaderBar.kt). %1$s is an ordinal, "2nd". -->
    <!-- Shown under the score when the place is shared with another player. -->
    <string name="game_standing_tied">=%1$s</string>
    <!-- Spoken in place of the shown place ("=" would be read as "equals"). -->
    <string name="game_standing_spoken">%1$s place</string>
    <string name="game_standing_tied_spoken">tied %1$s place</string>

